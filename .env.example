# Copy to .env and fill locally. Never commit .env.

TZ=Asia/Kolkata
PUID=1000
PGID=1000

# Immich
UPLOAD_LOCATION=/path/to/immich
DB_DATA_LOCATION=./postgres
IMMICH_VERSION=release
DB_PASSWORD=
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# NZBGet
NZBGET_USER=
NZBGET_PASS=

# Transmission
TRANSMISSION_USER=
TRANSMISSION_PASS=

# Beszel Podman agent
BESZEL_PODMAN_KEY=
BESZEL_PODMAN_TOKEN=

# Beszel Docker agent
BESZEL_DOCKER_KEY=
BESZEL_DOCKER_TOKEN=
