# Runtime application data / databases / logs
**/config/
**/logs/
**/*.log
**/*.db
**/*.db-shm
**/*.db-wal
**/*.pid
**/Sentry/
**/tmp/
**/queue/
**/resume/
**/torrents/
**/blocklists/

# Download / watch / NZB payloads
media/downloads/
media/nzb/
media/watch/
media/nzbget/downloads/
**/*.nzb
**/*.nzb.queued
**/*.torrent
**/*.part
**/*.tmp
**/recordings/*

# Beszel runtime state and keys
monitor/beszel_data/
monitor/data/
**/id_ed25519
**/id_ed25519.pub

# Immich / database runtime data
immich-app/postgres/
**/postgres/
**/pgdata/
**/database/

# Secrets and local environment overrides
.env
.env.*
!.env.example
**/secrets/
**/*.secret
**/*.conf
**/*.key
**/*.pem
**/*.crt
**/credentials*
**/token*

